{
  "name": "u-not",
  "description": "Updates Notifier",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@types/bun": "latest",
    "lefthook": "^2.1.12"
  },
  "scripts": {
    "lint": "biome check --write",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "schema:generate": "bun run src/core/config/generate-schema.ts",
    "build:linux": "bun build ./src/index.ts --compile --outfile ./dist/u-not-linux-x64 --target bun-linux-x64",
    "build:windows": "bun build ./src/index.ts --compile --outfile ./dist/u-not-windows-x64.exe --target bun-windows-x64",
    "build:macos-intel": "bun build ./src/index.ts --compile --outfile ./dist/u-not-darwin-x64 --target bun-darwin-x64",
    "build:macos-arm": "bun build ./src/index.ts --compile --outfile ./dist/u-not-darwin-arm64 --target bun-darwin-arm64"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "grammy": "^1.46.0",
    "jsonpath-plus": "^10.3.0",
    "zod": "^4.5.4"
  }
}
