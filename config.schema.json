{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "type": {
            "type": "string",
            "const": "api"
          },
          "jsonPath": {
            "type": "string"
          },
          "posterJsonPath": {
            "type": "string"
          },
          "linkJsonPath": {
            "type": "string"
          },
          "linkBaseUrl": {
            "type": "string",
            "format": "uri"
          },
          "posterBaseUrl": {
            "type": "string",
            "format": "uri"
          },
          "posterSize": {
            "type": "string"
          },
          "headers": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "flaresolverr": {
            "type": "boolean"
          }
        },
        "required": ["name", "url", "type", "jsonPath"],
        "additionalProperties": false
      }
    },
    "flaresolverr": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "api": {
          "type": "string"
        }
      },
      "required": ["url"],
      "additionalProperties": false
    },
    "telegram": {
      "type": "object",
      "properties": {
        "botToken": {
          "type": "string"
        },
        "chatId": {
          "anyOf": [
            {
              "type": ["string", "number"]
            },
            {
              "type": "array",
              "items": {
                "type": ["string", "number"]
              }
            }
          ]
        }
      },
      "required": ["botToken", "chatId"],
      "additionalProperties": false
    },
    "vk": {
      "type": "object",
      "properties": {
        "accessToken": {
          "type": "string"
        },
        "peerId": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "array",
              "items": {
                "type": "number"
              }
            }
          ]
        },
        "apiVersion": {
          "type": "string"
        }
      },
      "required": ["accessToken", "peerId"],
      "additionalProperties": false
    },
    "userAgent": {
      "type": "string"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": ["sources"],
  "additionalProperties": false
}
